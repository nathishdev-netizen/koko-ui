# Generated by `pnpm theme:build` from themes/<brand>/<brand>Theme.ts.
# Brand-agnostic patterns: naming kokofresh.js explicitly would silently commit
# a second brand's build output.
themes/*/theme.css
themes/*/*.js
themes/*/*.d.ts
!themes/*/*Theme.ts
!themes/*/fontSets.ts
!themes/*/fonts.ts
