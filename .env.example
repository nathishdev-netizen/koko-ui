# Frappe backend base URL. Leave empty while running on mocks.
NEXT_PUBLIC_API_BASE_URL=

# Comma-separated resources that should hit the real backend instead of mocks.
# Empty (default) = everything mocked. `*` = everything live.
# Opt resources in one at a time as the backend team ships them, e.g.:
#   NEXT_PUBLIC_API_LIVE_RESOURCES=products,collections
NEXT_PUBLIC_API_LIVE_RESOURCES=
